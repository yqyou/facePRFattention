    "deltalogullambda_d_subj = np.nanmean(deltalogullambda_d_session,axis=-1) # averaged across session\n",
    "deltalogullambda_subj = metric_distancebin(deltalogullambda_d_subj,nsample2,num_nf)[:,nf_i,:]\n",
