    "    for i in range(len(num_nf)):\n",
    "        for roi_i in range(nroi):\n",
    "            a = metric_subj[num_nf[i][0]:num_nf[i][1],:,roi_i].flatten()\n",
    "            metric_subj_nf[:len(a),i,roi_i] = a\n",
    "\n",
    "    return metric_subj_nf\n",
